# Copy to capstone/.env and fill in. Never commit .env. Write the key without quotes: OPENROUTER_API_KEY=sk-or-...

# Required: an OpenRouter key (https://openrouter.ai/keys). Rafeeq uses free models only.
# Free models allow 50 requests a day; a one-time purchase of 10 credits raises that to 1,000 a day
# (still free models, nothing is spent). Repeated identical requests are served from capstone/cache.
OPENROUTER_API_KEY=

# Optional: models (defaults shown)
# AGENT_MODEL=google/gemma-4-31b-it:free
# AGENT_SMALL_MODEL=google/gemma-4-26b-a4b-it:free
# AGENT_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b:free,dots-studio/dots-3-note-preview:free
# AGENT_CACHE=1                    # 0 = always call the model
# AGENT_QUICK=1                    # smaller workloads

# Optional: the API and web app (rafeeq serve); defaults shown, comma-separate several keys
# RAFEEQ_API_KEYS=dev-key-1
# RAFEEQ_OFFICER_KEYS=officer-key-1
# RAFEEQ_SESSION_TOKENS=150000
